{
  "name": "SalesSlice Executive Analytics",
  "dataColors": [
    "#0EA5E9",
    "#10B981",
    "#6366F1",
    "#F59E0B",
    "#EC4899",
    "#8B5CF6",
    "#14B8A6",
    "#F97316"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#0EA5E9",
  "visualStyles": {
    "*": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#F8FAFC" } } }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#00000010" } },
            "angle": 90,
            "shadowBlur": 6
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}
